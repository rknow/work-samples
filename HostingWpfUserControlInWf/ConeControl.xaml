<UserControl x:Class="HostingWpfUserControlInWf.ConeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="400" Width="400">

<UserControl.Resources>
        <!-- Define a Radial Gradient for a 3D effect -->
        <RadialGradientBrush x:Key="ConeGradient" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="LightBlue" Offset="0" />
            <GradientStop Color="Blue" Offset="1" />
        </RadialGradientBrush>
    </UserControl.Resources>

    <Grid>
        <!-- Path for 2D Cone -->
        <Path Fill="{StaticResource ConeGradient}" Stroke="Black" StrokeThickness="2">
            <Path.Data>
                <PathGeometry>
                    <PathFigure StartPoint="150,50">
                        <!-- Left side of the cone -->
                        <LineSegment Point="50,200" />
                        <!-- Right side of the cone -->
                        <LineSegment Point="250,200" />
                        <!-- Close the path to form the cone -->
                        <LineSegment Point="150,50" />
                    </PathFigure>

                     <PathFigure StartPoint="50,200">
                        <!-- Arc for half-circle, draws from left to right -->
                        <ArcSegment Point="250,200" Size="100,50" 
                        SweepDirection="Counterclockwise" IsLargeArc="True" />
                    </PathFigure>
                </PathGeometry>
            </Path.Data>
        </Path>
    </Grid>
</UserControl>
